		local x = math.cos(a) * S.domeRadius * 0.8
		local z = math.sin(a * 0.8) * S.domeRadius * 0.8
		local y = S.domeRadius * (0.85 + 0.1 * math.sin(a * 1.3))
		p.CFrame = CFrame.new(domeCenter + Vector3.new(x, y, z))
		local bm = p:FindFirstChildOfClass("Beam")
		if bm then
			local k = 0.5 + 0.5 * math.sin(timeAcc * 0.8 + i)
			bm.Color = ColorSequence.new(c1:Lerp(c2, k), c2:Lerp(c1, k))
			bm.Transparency = NumberSequence.new(0.45 + 0.3 * math.sin(timeAcc * 1.1 + i * 1.7))
		end
