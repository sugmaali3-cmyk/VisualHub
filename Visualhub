local function E(spread, lo, hi, acc, sz)
	return { spread = spread, speed = NumberRange.new(lo, hi), accel = acc or Vector3.zero, size = sz or 0.4 }
end

local function star(j, t)
	local ang = j * math.pi / 5 - math.pi / 2 + t * 0.4
	local r = (j % 2 == 0) and 2.6 or 1.2
	return Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r)
end

local function hash(x)
	return (math.sin(x * 12.9898) * 43758.5453) % 1
end

