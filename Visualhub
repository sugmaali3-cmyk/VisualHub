	mk("Trail", {
		Attachment0 = a0,
		Attachment1 = a1,
		Lifetime = 0.5,
		LightEmission = 1,
		Color = ColorSequence.new(WHITE, c1),
		Transparency = NumberSequence.new(0, 1),
		WidthScale = NumberSequence.new(0.8, 0),
	}, part)
	table.insert(rainShooters, { p = part, a = start, b = stop, t0 = timeAcc, dur = 1.1 })
end

local function updateRain(dt, c1, base)
	if S.rainStars then
		rainAcc += dt
		local interval = 0.25 / math.max(S.rainAmt, 0.1)
		while rainAcc >= interval do
			rainAcc -= interval
			spawnRainStar(c1, base)
		end
	end
	for k = #rainShooters, 1, -1 do
		local s = rainShooters[k]
		local prog = (timeAcc - s.t0) / s.dur
		if prog >= 1 then
			s.p:Destroy()
			table.remove(rainShooters, k)
		else
			s.p.CFrame = CFrame.new(s.a:Lerp(s.b, prog))
		end
	end
end

local function clearRain()
	for _, s in ipairs(rainShooters) do
		if s.p then
			s.p:Destroy()
		end
	end
	rainShooters = {}
end

