local function dirForStyle(style, i, n)
	if style == 1 then
		local y = 0.12 + 0.88 * (i - 0.5) / n
		local r = math.sqrt(math.max(0, 1 - y * y))
		local th = GOLD * i
		return Vector3.new(math.cos(th) * r, y, math.sin(th) * r)
	elseif style == 2 then
		local y = 1 - 2 * (i - 0.5) / n
		local r = math.sqrt(math.max(0, 1 - y * y))
		local th = GOLD * i
		return Vector3.new(math.cos(th) * r, y, math.sin(th) * r)
	elseif style == 3 then
		local f = (i - 1) / math.max(n - 1, 1)
		local a = i * 2.399
		return Vector3.new(math.cos(a), 0.1 + 0.9 * f, math.sin(a)).Unit
	end
	return Vector3.new(0, 1, 0)
end

local function makeBeam(i, j, col)
	local a0 = starNodes[i]:FindFirstChild("VH_S")
	local a1 = starNodes[j]:FindFirstChild("VH_S")
	if a0 and a1 then
		local bm = mk("Beam", {
			Attachment0 = a0,
			Attachment1 = a1,
			Width0 = 0.07,
			Width1 = 0.07,
			FaceCamera = true,
			LightEmission = 1,
			Color = ColorSequence.new(col),
			Transparency = NumberSequence.new(0.5),
		}, starNodes[i])
		table.insert(starBeams, bm)
		table.insert(starLinks, { i, j })
	end
end

local function buildStars()
	for _, p in ipairs(starNodes) do
		p:Destroy()
	end
	for _, b in ipairs(starBeams) do
		b:Destroy()
	end
	starNodes, starBeams, starDirs, starLayer, starPhase, starLinks = {}, {}, {}, {}, {}, {}
	if not S.stars then
		return
	end
	local n = S.starCount
	local style = S.domeStyle
	local perLayer = math.max(math.ceil(n / 3), 1)

	for i = 1, n do
		starDirs[i] = dirForStyle(style, i, n)
		starLayer[i] = (i - 1) % 3 + 1
		starPhase[i] = (math.floor((i - 1) / 3) / perLayer) * math.pi * 2
		local p = mk("Part", {
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.45,
			Material = Enum.Material.Neon,
			Color = WHITE,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		}, workspace)
		mk("Attachment", { Name = "VH_S" }, p)
		table.insert(starNodes, p)
	end

	if style == 4 then
		for i = 1, n do
			local j = i + 3
			if j > n then
				j = starLayer[i]
			end
			if j ~= i and j >= 1 and j <= n then
				makeBeam(i, j, WHITE)
			end
		end
	else
		for i = 1, n do
			for j = i + 1, n do
				if (starDirs[i] - starDirs[j]).Magnitude < S.starLink then
					makeBeam(i, j, WHITE)
				end
			end
		end
	end
end

local function spawnShooter(col)
