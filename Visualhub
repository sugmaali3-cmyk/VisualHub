local function makeToggle(parent, text, key, cb)
	local card = mk("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = THEME.panel,
		Text = "",
		AutoButtonColor = false,
	}, parent)
