local function updateDome(c1, animT)
	local R = S.domeRadius
	local style = S.domeStyle
	local ang = animT * S.starSpin
	local ca, sa = math.cos(ang), math.sin(ang)
	local tilt = 0.25 * math.sin(animT * 0.3)
	local ct, st = math.cos(tilt), math.sin(tilt)
	local breath = 1 + 0.04 * math.sin(animT * 1.5)
	local starCol = c1:Lerp(WHITE, 0.5)

	for i, p in ipairs(starNodes) do
		local pos
		if style == 4 then
			local L = starLayer[i]
			local tl = ORBIT_TILT[L]
			local a = starPhase[i] + animT * ORBIT_SPD[L] * S.speed
			local dx = math.cos(a)
			local dy = math.sin(a) * math.cos(tl)
			local dz = math.sin(a) * math.sin(tl)
			local x1 = dx * ca - dz * sa
			local z1 = dx * sa + dz * ca
			pos = Vector3.new(x1, dy, z1) * R
		else
			local d = starDirs[i]
			local x1 = d.X * ca - d.Z * sa
			local z1 = d.X * sa + d.Z * ca
			local y1 = d.Y
			local y2 = y1 * ct - z1 * st
			local z2 = y1 * st + z1 * ct
			pos = Vector3.new(x1, y2, z2) * R * breath
		end
		p.CFrame = CFrame.new(domeCenter + pos)
		local w = 0.5 + 0.5 * math.sin(animT * (1.2 + (i % 5) * 0.3) + i * 0.35)
		p.Transparency = 1 - S.starBright * (0.45 + 0.55 * w)
		p.Color = starCol
	end

	for _, bm in ipairs(starBeams) do
		local tr = 0.55 + 0.35 * math.sin(animT * 2 + bm.Width0 * 90)
		bm.Color = ColorSequence.new(starCol)
		bm.Transparency = NumberSequence.new(math.clamp(1 - S.starBright * tr, 0, 1))
	end
end

local function updateShooters(dt, c1)
	if S.stars and S.shooting then
		shootAcc += dt
		if shootAcc > 3.2 then
			shootAcc = 0
			spawnShooter(c1)
		end
	end
	for k = #shooters, 1, -1 do
		local s = shooters[k]
		local prog = (timeAcc - s.t0) / s.dur
		if prog >= 1 then
			s.p:Destroy()
			table.remove(shooters, k)
		else
			s.p.CFrame = CFrame.new(domeCenter + s.a:Lerp(s.b, prog))
		end
	end
end

local function clearShooters()
	for _, s in ipairs(shooters) do
		if s.p then
			s.p:Destroy()
		end
	end
	shooters = {}
end

