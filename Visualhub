	local b = (a + Vector3.new(rnd() * 0.7, -0.3 - math.random() * 0.4, rnd() * 0.7)).Unit
	if b.Y < 0.05 then
		b = Vector3.new(b.X, 0.05, b.Z).Unit
	end
	local part = mk("Part", {
		Size = Vector3.one * 0.2,
