-- ===== ОТКРЫТЬ / ЗАКРЫТЬ =====
setOpen = function(v)
	isOpen = v
	floatBtn.Text = v and "ЗАКРЫТЬ" or "МЕНЮ"
	if v then
		main.Visible = true
		main.GroupTransparency = 1
		main.Position = UDim2.new(0.5, 0, 0.5, 18)
		main.Size = UDim2.fromOffset(W * 0.94, H * 0.94)
		tw(main, 0.45, { GroupTransparency = 0, Size = UDim2.fromOffset(W, H), Position = UDim2.new(0.5, 0, 0.5, 0) }, Enum.EasingStyle.Back)
	else
		local t = tw(main, 0.25, { GroupTransparency = 1, Size = UDim2.fromOffset(W * 0.94, H * 0.94), Position = UDim2.new(0.5, 0, 0.5, 18) }, Enum.EasingStyle.Quad)
		t.Completed:Connect(function()
			if not isOpen then
				main.Visible = false
			end
		end)
	end
end

bind(closeBtn.MouseButton1Click, function()
	setOpen(false)
end)

bind(floatBtn.MouseButton1Click, function()
	setOpen(not isOpen)
end)

bind(UIS.InputBegan, function(i, gp)
	if gp then
		return
	end
	local k = i.KeyCode
	if k == Enum.KeyCode.RightShift then
		setOpen(not isOpen)
	elseif k == Enum.KeyCode.N then
		nextAura(false)
	elseif k == Enum.KeyCode.P then
		nextShape()
	elseif k == Enum.KeyCode.C then
		nextColorMode()
	elseif k == Enum.KeyCode.L then
		S.partLight = not S.partLight
		refreshAll()
		notify("Свет деталей: " .. (S.partLight and "вкл" or "выкл"))
	elseif k == Enum.KeyCode.R then
		randomize()
	elseif k == Enum.KeyCode.F then
		S.flicker = not S.flicker
		refreshAll()
		notify("Мерцание: " .. (S.flicker and "вкл" or "выкл"))
	elseif k == Enum.KeyCode.H then
		S.showHud = not S.showHud
		hudBox.Visible = S.showHud
		refreshAll()
		notify("FPS и пинг: " .. (S.showHud and "вкл" or "выкл"))
	elseif k == Enum.KeyCode.G then
		S.ghost = not S.ghost
		applyGhost()
		refreshAll()
		notify("Призрак: " .. (S.ghost and "вкл" or "выкл"))
	end
end)

-- ===== СТАРТ =====
main.Visible = true
setOpen(true)
selectTab(1)
applyAll()
notify("Visual Hub v14 загружен")
