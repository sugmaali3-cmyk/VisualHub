local function makeAuraCards(parent)
	local search = mk("TextBox", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = THEME.panel,
		Text = "",
		PlaceholderText = "Поиск ауры...",
		PlaceholderColor3 = THEME.dim,
		TextColor3 = THEME.text,
		Font = FM,
		TextSize = 12,
		ClearTextOnFocus = false,
	}, parent)
	corner(search, 8)
	mk("UIPadding", { PaddingLeft = UDim.new(0, 12) }, search)

	local groups, allCards = {}, {}

	for _, cat in ipairs(AURA_CATS) do
		local title = section(parent, cat)
		local holder = mk("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
		}, parent)
		mk("UIGridLayout", {
			CellSize = UDim2.new(0.5, -4, 0, 38),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, holder)

		local group = { title = title, holder = holder, cards = {} }
		for i, a in ipairs(AURAS) do
			if a.cat == cat then
				local c = mk("TextButton", {
					BackgroundColor3 = WHITE,
					Text = "",
					AutoButtonColor = false,
					LayoutOrder = i,
				}, holder)
				corner(c, 8)
				local seq
				if a.c3 then
					seq = ColorSequence.new({ kp(0, a.c1), kp(0.5, a.c3), kp(1, a.c2) })
				else
					seq = ColorSequence.new(a.c1, a.c2)
				end
				mk("UIGradient", { Color = seq, Rotation = 90 }, c)
				local st = stroke(c, WHITE, 1.5, 1)
				local nm = label(c, a.name, UDim2.new(0, 8, 0, 0), UDim2.new(1, -16, 1, 0), WHITE, FB, 11)
				nm.TextStrokeTransparency = 0.4
				addPress(c)
				bind(c.MouseButton1Click, function()
					S.auraIdx = i
					applyEmitter()
					refreshAll()
					notify("Аура: " .. a.name)
				end)
				local card = { btn = c, stroke = st, idx = i, name = a.name }
				table.insert(group.cards, card)
				table.insert(allCards, card)
			end
		end
		table.insert(groups, group)
	end

	local function render()
		for _, c in ipairs(allCards) do
			c.stroke.Transparency = (S.auraIdx == c.idx) and 0 or 1
		end
	end

	bind(search:GetPropertyChangedSignal("Text"), function()
		local q = string.lower(search.Text)
		for _, g in ipairs(groups) do
			local shown = 0
			for _, c in ipairs(g.cards) do
				local ok = q == "" or string.find(string.lower(c.name), q, 1, true) ~= nil
				c.btn.Visible = ok
				if ok then
					shown += 1
				end
			end
			g.title.Visible = shown > 0
			g.holder.Visible = shown > 0
		end
	end)

	table.insert(refreshers, render)
	render()
end

local function pct(v)
	return string.format("%d%%", math.floor(v * 100 + 0.5))
end

local function num(v)
	return string.format("%d", math.floor(v + 0.5))
end

local function mult(v)
	return string.format("%.1fx", v)
end

local function clockFmt(v)
	return string.format("%02d:%02d", math.floor(v), math.floor((v % 1) * 60 + 0.5))
end

local function degFmt(v)
	return string.format("%d°", math.floor(v * 360 + 0.5))
end

local function secFmt(v)
	return string.format("%d с", math.floor(v + 0.5))
end

local function f2(v)
	return string.format("%.2f", v)
end

