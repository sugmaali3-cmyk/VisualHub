local function clearFx()
	for _, p in ipairs(fx.parts) do
		p:Destroy()
	end
	fx.parts = {}
	fx.beams = {}
	for _, key in ipairs({ "ring", "ring2", "attach", "feet", "hl" }) do
		if fx[key] then
			fx[key]:Destroy()
			fx[key] = nil
		end
	end
	fx.aura = nil
	fx.trail = nil
	fx.dust = nil
end

local function effDensity()
	return S.density * QUALITY[S.quality].mul
end

local function buildParts()
	for _, p in ipairs(fx.parts) do
		p:Destroy()
	end
	fx.parts = {}
	fx.beams = {}
	if not root then
		return
	end
	local sh = SHAPES[S.shapeIdx]
	if sh.cnt == 0 then
		return
	end
	local n = math.max(1, math.floor(sh.cnt * effDensity() + 0.5))
	local dim = sh.dim or Vector3.one
	for i = 1, n do
		local p = mk("Part", {
			Shape = sh.part or Enum.PartType.Ball,
			Material = Enum.Material.Neon,
			Size = dim * sh.size,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		}, workspace)
		if sh.mesh then
			mk("SpecialMesh", { MeshType = sh.mesh, Scale = Vector3.one }, p)
		end
		if sh.beam then
			mk("Attachment", { Name = "VH_A" }, p)
		end
		mk("PointLight", { Range = S.lightRange, Brightness = 0.8, Shadows = false, Enabled = S.partLight }, p)
		table.insert(fx.parts, p)
	end

	if sh.beam then
		local links = {}
		for i = 1, n do
			table.insert(links, { i, i % n + 1 })
			if sh.beam == 2 then
				table.insert(links, { i, (i + 2) % n + 1 })
			end
		end
		for _, l in ipairs(links) do
			local pa = fx.parts[l[1]]
			local pb = fx.parts[l[2]]
			local a0 = pa and pa:FindFirstChild("VH_A")
			local a1 = pb and pb:FindFirstChild("VH_A")
			if a0 and a1 then
				local bm = mk("Beam", {
					Attachment0 = a0,
					Attachment1 = a1,
					Width0 = 0.08,
					Width1 = 0.08,
					LightEmission = 1,
					FaceCamera = true,
					Transparency = NumberSequence.new(0.2),
				}, pa)
				table.insert(fx.beams, bm)
			end
		end
	end
end

local function applyEmitter()
	if not fx.aura then
		return
	end
	local a = AURAS[S.auraIdx]
	local sh = SHAPES[S.shapeIdx]
	fx.aura.Texture = a.tex or TEX.spark
	fx.aura.Lifetime = NumberRange.new(0.8, 1.5)
	fx.aura.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, sh.emit.size),
		NumberSequenceKeypoint.new(1, 0),
	})
	fx.aura.Speed = sh.emit.speed
	fx.aura.SpreadAngle = Vector2.new(sh.emit.spread, sh.emit.spread)
	fx.aura.Acceleration = sh.emit.accel + (a.accel or Vector3.zero)
end

