	label(card, text, UDim2.fromOffset(12, 0), UDim2.new(1, -70, 1, 0), THEME.text, FM, 12)

	local track = mk("Frame", {
		Size = UDim2.fromOffset(34, 18),
		Position = UDim2.new(1, -46, 0.5, -9),
		BackgroundColor3 = THEME.off,
	}, card)
