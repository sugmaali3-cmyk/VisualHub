local function getColors()
	local aura = AURAS[S.auraIdx]
	local c1, c2, c3 = aura.c1, aura.c2, aura.c3
	if S.custom then
		c1 = hsv(S.hue, 0.75, 1)
		c2 = hsv((S.hue + 0.12) % 1, 0.9, 0.6)
		c3 = nil
	end
	local mode = S.colorMode
	if S.rainbow or mode == 3 then
		c1 = hsv(hue, 0.75, 1)
		c2 = hsv((hue + 0.33) % 1, 0.75, 1)
		c3 = nil
	elseif mode == 2 then
		local k = 0.5 + 0.5 * math.sin(timeAcc * 3)
		c1 = c1:Lerp(WHITE, k * 0.45)
	elseif mode == 4 then
		c2 = c1
		c3 = nil
	end
	return c1, c2, c3, aura
end

-- ===== ГЛАВНЫЙ ЦИКЛ =====
bind(RunService.Heartbeat, function(dt)
	if unloaded then
		return
	end
	timeAcc += dt
	hue = (hue + dt * 0.2) % 1
	frameAvg = frameAvg * 0.95 + dt * 0.05

	statAcc += dt
	if statAcc >= 0.5 then
		statAcc = 0
		fpsNow = math.floor(1 / math.max(frameAvg, 0.001) + 0.5)
		if fpsNow > peakFps then
			peakFps = fpsNow
		end
		pingAcc += 0.5
		if pingAcc >= 1 then
			pingAcc = 0
			pingNow = math.floor(getPing() + 0.5)
		end
		updateStats()
	end

	for i, g in ipairs(spinGrads) do
		g.Rotation = (timeAcc * 40 + i * 90) % 360
	end

	if S.cycle then
		cycleAcc += dt
		if cycleAcc >= S.cycleSec then
			cycleAcc = 0
			nextAura(true)
		end
	end

	if S.cycleShape then
		shapeAcc += dt
		if shapeAcc >= S.shapeSec then
			shapeAcc = 0
			S.shapeIdx = S.shapeIdx % #SHAPES + 1
			applyEmitter()
			buildParts()
			refreshAll()
		end
	end

	local cam = workspace.CurrentCamera
	local c1, c2, c3, aura = getColors()
	local beat = 0.5 + 0.5 * math.sin(timeAcc * (aura.beat or 2) * S.speed)
	local hasRoot = root and root.Parent
	local basePos = (hasRoot and root.Position) or (cam and cam.CFrame.Position) or Vector3.zero

	if snowPart and snowEmBig and snowEmSmall then
		snowPart.CFrame = CFrame.new(basePos + Vector3.new(0, S.snowHeight, 0))
		local wx = math.sin(timeAcc * 0.6) * S.snowWind * 3
		local wz = math.cos(timeAcc * 0.45) * S.snowWind * 2
		local acc = Vector3.new(wx, -0.8, wz)
		snowEmBig.Acceleration = acc
		snowEmSmall.Acceleration = acc
		snowEmBig.Rate = 22 * S.snowAmt
		snowEmSmall.Rate = 90 * S.snowAmt
		snowEmBig.Speed = NumberRange.new(3 * S.snowSpeed, 5 * S.snowSpeed)
		snowEmSmall.Speed = NumberRange.new(4 * S.snowSpeed, 6 * S.snowSpeed)
		snowEmBig.Size = NumberSequence.new(0.35 * S.snowSize)
		snowEmSmall.Size = NumberSequence.new(0.12 * S.snowSize)
	end

	domeCenter = (hasRoot and root.Position + Vector3.new(0, 10, 0)) or basePos
	if #starNodes > 0 then
		local animT = S.domeAnim and timeAcc or 0
		updateDome(c1, animT)
		updateShooters(dt, c1)
	elseif #shooters > 0 then
		clearShooters()
	end

	updateAurora(c1, c2)
	updateRain(dt, c1, basePos)

	if S.fogPulse then
		atmos.Density = S.fog * (0.85 + 0.15 * math.sin(timeAcc * 0.8))
	end

	if not hasRoot then
		return
	end

	local sh = SHAPES[S.shapeIdx]
	local cf = root.CFrame
	local dens = effDensity()

	if fx.aura then
		fx.aura.Enabled = S.aura
		if c3 then
			fx.aura.Color = ColorSequence.new({ kp(0, c1), kp(0.5, c3), kp(1, c2) })
		else
			fx.aura.Color = ColorSequence.new(c1, c2)
		end
		local boost = S.beatFx and (0.8 + 0.4 * beat) or 1
		fx.aura.Rate = math.min(aura.rate * dens * S.auraPower * boost, 320)
	end

	if fx.dust then
		fx.dust.Enabled = S.dust
		fx.dust.Color = ColorSequence.new(c2, c1)
	end

	if fx.trail then
		local v = root.AssemblyLinearVelocity
		local spd = Vector3.new(v.X, 0, v.Z).Magnitude
		fx.trail.Enabled = S.trail
		fx.trail.Rate = S.trail and math.clamp(spd * 5, 0, 150) or 0
		fx.trail.Color = ColorSequence.new(c2, c1)
	end

	if fx.ring then
		fx.ring.Color = c1
		fx.ring.Size = Vector3.new(0.12, S.ringSize, S.ringSize)
		fx.ring.Transparency = S.ring and (0.25 + beat * 0.5) or 1
		fx.ring.CFrame = cf * CFrame.new(0, -2.9, 0) * CFrame.Angles(0, 0, math.rad(90))
	end

	if fx.ring2 then
		fx.ring2.Color = c2
		fx.ring2.Size = Vector3.new(0.1, S.ringSize * 0.7, S.ringSize * 0.7)
		fx.ring2.Transparency = S.ring2 and (0.4 + (1 - beat) * 0.4) or 1
		fx.ring2.CFrame = cf * CFrame.new(0, -2.9, 0) * CFrame.Angles(0, timeAcc * 0.8, math.rad(90))
	end

	if fx.hl then
		fx.hl.Enabled = S.outline
		fx.hl.OutlineColor = c1
		fx.hl.FillColor = c2
		fx.hl.FillTransparency = S.outline and (0.75 + 0.2 * (1 - beat)) or 1
	end

	if S.lightGrade then
		local base = GRADES[S.gradeIdx]
		local amt = S.lightGradeAmt
		local target = base.tint:Lerp(c1, amt * 0.55)
		grade.TintColor = grade.TintColor:Lerp(target, 0.12)
		grade.Saturation = grade.Saturation + ((base.sat + amt * 0.25) - grade.Saturation) * 0.12
		local ambTarget = ORIG_AMB:Lerp(c1, amt * 0.3)
		Lighting.OutdoorAmbient = Lighting.OutdoorAmbient:Lerp(ambTarget, 0.1)
	end

	local n = #fx.parts
	if n > 0 and sh.pos then
		local t = timeAcc * S.speed
		local sp = (sh.spin or 0.5) * S.spin
		local forceField = aura.mat == Enum.Material.ForceField
		local pulseK = forceField and (0.7 + 0.6 * beat) or 1
		local scale = sh.size * S.orbSize * (S.beatFx and (0.85 + 0.35 * beat) or 1) * pulseK
		local dim = sh.dim or Vector3.one
		local mat = aura.mat or Enum.Material.Neon
		for i, p in ipairs(fx.parts) do
			local off = sh.pos(i, n, t)
			local world = cf:PointToWorldSpace(off)
			local o = sh.orient
			if o == "yaw" then
				p.CFrame = CFrame.new(world) * CFrame.Angles(0, timeAcc * sp + math.atan2(off.X, off.Z), 0)
			elseif o == "vert" then
				p.CFrame = CFrame.new(world) * CFrame.Angles(0, timeAcc * sp, math.rad(90))
			elseif o == "flat" then
				p.CFrame = CFrame.lookAt(world, cf.Position) * CFrame.Angles(0, 0, timeAcc * sp)
			elseif o == "radial" then
				local dir = cf:VectorToWorldSpace(Vector3.new(off.X, 0, off.Z))
				if dir.Magnitude < 0.01 then
					dir = Vector3.new(0, 0, 1)
				end
				p.CFrame = CFrame.lookAt(world, world + dir)
			else
				p.CFrame = CFrame.new(world) * CFrame.Angles(timeAcc * sp, timeAcc * sp * 0.7, 0)
			end
			p.Size = dim * scale
			p.Material = mat
			if c3 and i % 3 == 0 then
				p.Color = c3
			else
				p.Color = (i % 2 == 0) and c2 or c1
			end
			if not S.parts then
				p.Transparency = 1
			elseif S.flicker then
				p.Transparency = 0.1 + 0.35 * math.abs(math.sin(timeAcc * 12 + i * 1.7))
			else
				p.Transparency = 0
			end
			local pl = p:FindFirstChildOfClass("PointLight")
			if pl then
				pl.Enabled = S.partLight and S.parts
				pl.Color = p.Color
				pl.Range = S.lightRange
			end
		end
		for _, b in ipairs(fx.beams) do
			b.Enabled = S.parts
			b.Color = ColorSequence.new(c1, c2)
		end
	end
end)

local function onCharacter(c)
