	return card
end

local function makeSlider(parent, text, key, minV, maxV, step, fmt, cb, rainbowTrack)
	local card = mk("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = THEME.panel }, parent)
	corner(card, 8)
	label(card, text, UDim2.fromOffset(12, 6), UDim2.new(1, -110, 0, 16), THEME.text, FM, 12)
	local val = label(card, "", UDim2.new(1, -100, 0, 6), UDim2.fromOffset(88, 16), THEME.dim, FB, 11, Enum.TextXAlignment.Right)

	local track = mk("TextButton", {
		Position = UDim2.new(0, 12, 1, -14),
		Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = THEME.off,
		Text = "",
		AutoButtonColor = false,
	}, card)
	corner(track, 3)

	local fill = mk("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, track)
	corner(fill, 3)
	if rainbowTrack then
		track.BackgroundColor3 = WHITE
		mk("UIGradient", { Color = RAINBOW }, track)
		fill.Visible = false
	end

	local knob = mk("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = WHITE,
	}, track)
	corner(knob, 6)

	local function render()
		local r = math.clamp((S[key] - minV) / (maxV - minV), 0, 1)
		val.Text = fmt(S[key])
		tw(fill, 0.15, { Size = UDim2.new(r, 0, 1, 0) })
		tw(knob, 0.15, { Position = UDim2.new(r, 0, 0.5, 0) })
	end

	local function setFromX(x)
		local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = minV + (maxV - minV) * rel
		if step then
			v = math.floor(v / step + 0.5) * step
		end
		v = math.clamp(v, minV, maxV)
		if v ~= S[key] then
			S[key] = v
			render()
			if cb then
				cb(v)
			end
		end
	end

	bind(track.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			activeSlider = setFromX
			setFromX(i.Position.X)
		end
	end)

	table.insert(refreshers, render)
	render()
	return card
end

local function makePills(parent, list, key, cb)
