local function tw(obj, t, props, style)
	local tween = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		o[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function corner(p, r)
	return mk("UICorner", { CornerRadius = UDim.new(0, r or 8) }, p)
end

local function stroke(p, col, th, tr)
	return mk("UIStroke", { Color = col or WHITE, Thickness = th or 1, Transparency = tr or 0.85 }, p)
end

local function label(p, text, pos, size, color, font, ts, align)
